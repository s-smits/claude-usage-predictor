# One line an account. Make a token for each with `claude setup-token`, signed in to that account.
# Copy this file to `.env` (ignored by Git) and fill it in; the `.env` of the folder a command runs
# in is loaded, under Bun and under Node.
CLAUDE_CODE_OAUTH_TOKEN1=
CLAUDE_CODE_OAUTH_TOKEN2=
# A name works as well as a number:
# CLAUDE_CODE_OAUTH_TOKEN_WORK=

# The accounts work may spend when the pool is asked how long it lasts. Every account where unset.
# CLAUDE_USAGE_POOL=1,2

# A command that prints the live sessions an account as one JSON object, such as {"1":2,"2":0}.
# CLAUDE_USAGE_LIVE_CMD=

# Where the readings are kept. ~/.local/state/claude-usage-predictor/history.jsonl where unset.
# CLAUDE_USAGE_HISTORY=
